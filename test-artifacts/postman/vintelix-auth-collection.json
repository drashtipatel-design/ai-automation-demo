{
  "info": {
    "name": "Vintelix Auth API - SCRUM-7 & SCRUM-8",
    "_postman_id": "vintelix-auth-001",
    "description": "Complete API test collection for Login (SCRUM-7) and Signup endpoints. Base URL: http://localhost:8080",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "auth_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "valid_username",
      "value": "drashti@example.com",
      "type": "string"
    },
    {
      "key": "valid_email",
      "value": "drashti@example.com",
      "type": "string"
    },
    {
      "key": "valid_password",
      "value": "Root@1234",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Auth - Login",
      "item": [
        {
          "name": "TC-035: Login with valid username",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Response has token', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json).to.have.property('token').that.is.not.empty;",
                  "});",
                  "",
                  "pm.test('Token is JWT format', function () {",
                  "    var token = pm.response.json().token;",
                  "    var parts = token.split('.');",
                  "    pm.expect(parts.length).to.equal(3);",
                  "});",
                  "",
                  "pm.test('Response time is under 2000ms', function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(2000);",
                  "});",
                  "",
                  "// Store token for reuse",
                  "var json = pm.response.json();",
                  "if (json.token) {",
                  "    pm.collectionVariables.set('auth_token', json.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"usernameOrEmail\": \"{{valid_username}}\",\n    \"password\": \"{{valid_password}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/login",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "login"]
            }
          }
        },
        {
          "name": "TC-036: Login with valid email",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Response contains token', function () {",
                  "    pm.expect(pm.response.json()).to.have.property('token');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"usernameOrEmail\": \"{{valid_email}}\",\n    \"password\": \"{{valid_password}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/login",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "login"]
            }
          }
        },
        {
          "name": "TC-037: Login with wrong password",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 401', function () {",
                  "    pm.response.to.have.status(401);",
                  "});",
                  "",
                  "pm.test('Response does not contain token', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json).to.not.have.property('token');",
                  "});",
                  "",
                  "pm.test('Error message is generic', function () {",
                  "    var body = pm.response.text();",
                  "    pm.expect(body).to.not.include('password is incorrect');",
                  "    pm.expect(body).to.not.include('user not found');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"usernameOrEmail\": \"{{valid_username}}\",\n    \"password\": \"WrongPassword999\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/login",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "login"]
            }
          }
        },
        {
          "name": "TC-038: Login with non-existent user",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 401', function () {",
                  "    pm.response.to.have.status(401);",
                  "});",
                  "",
                  "pm.test('Same error as wrong password (no user enumeration)', function () {",
                  "    var body = pm.response.text();",
                  "    pm.expect(body).to.not.include('user not found');",
                  "    pm.expect(body).to.not.include('does not exist');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
